<AuMainContainer as |m|>
  <m.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content">
        <SnippetManagement::Filters
          @onChangeLabel={{this.changeFilterLabel.perform}}
          @label={{this.label}}
          @onChangeTags={{this.changeFilterTags}}
          @onResetFilters={{this.resetFilters}}
          @selectedTags={{this.model.selectedTags}}
        />
      </div>
    </div>
  </m.sidebar>
  <m.content @scroll={{true}}>
    <AuDataTable
      @content={{this.model.codelists}}
      @fields="Label"
      @noDataMessage={{t "codelist.crud.no-data"}}
      @size={{this.size}}
      @page={{this.page}}
      @sort={{this.sort}}
      as |s|
    >
      <s.menu as |menu|>
        <menu.general>
          <AuToolbar class="au-o-box" as |Group|>
            <Group>
              <AuHeading @skin="2">
                {{t "codelist.name"}}
              </AuHeading>
            </Group>
            <Group class="au-c-toolbar__group--center">
              <AuLink
                @route="codelist-management.new"
                @icon="add"
                @skin="button"
              >
                {{t "codelist.crud.new"}}
              </AuLink>
              {{#if this.isReadMode}}
                <AuButton
                  {{on "click" (set this "isReadMode" false)}}
                  @skin="secondary"
                  @icon="pencil"
                >{{t "template-management.edit-mode"}}</AuButton>
              {{else}}
                <AuButton
                  {{on "click" (set this "isReadMode" true)}}
                  @skin="secondary"
                  @icon="pencil"
                >{{t "template-management.read-mode"}}</AuButton>
              {{/if}}
            </Group>
          </AuToolbar>
        </menu.general>
      </s.menu>
      <s.content as |c|>
        <c.header>
          <th>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                @checked={{this.selectAllChecked}}
                {{on "click" this.toggleSelectAll}}
              />
            {{/let}}
          </th>
          <AuDataTableThSortable
            @field=":no-case:label"
            @currentSorting={{this.sort}}
            @label={{t "codelist.attr.label"}}
          />
          <th>{{t "codelist.attr.id"}}</th>
          <AuDataTableThSortable
            @field="createdOn"
            @currentSorting={{this.sort}}
            @label={{t "codelist.attr.created-on"}}
          />
          <th class="snippet-management__tags-cell">{{t
              "codelist.attr.tags"
            }}</th>
          <th></th>
        </c.header>
        <c.body as |codelist|>
          <td>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                value={{codelist.uri}}
                @checked={{this.isSelected codelist.uri}}
                {{on "click" this.changeCodelistSelection}}
              />
            {{/let}}
          </td>
          <td>
            <AuLink
              @skin="primary"
              @route="codelist-management.edit"
              @model={{codelist.id}}
            >
              {{codelist.label}}
            </AuLink>
          </td>
          <td>
            {{codelist.id}}
          </td>
          <td>
            {{#if codelist.createdOn}}
              {{detailed-date codelist.createdOn}}
            {{else}}
              {{t "codelist.attr.not-found"}}
            {{/if}}
          </td>
          <td>
            {{#if this.isReadMode}}
              <Common::Tags::CollapsibleTagList @tags={{codelist.tags}} />
            {{else}}
              <Common::Tags::TagSelector
                @tags={{this.tagManager.tags}}
                @onChange={{fn this.changeTagsFor codelist}}
                @selectedTags={{codelist.tags}}
                @allowTagCreation={{true}}
                @tagConstructor={{this.tagManager.createTag}}
                @tagList={{this.tagList}}
              />
            {{/if}}
          </td>
          <td>
            <AuButton
              @skin="naked"
              @icon="trash"
              @alert={{true}}
              @hideText={{true}}
              {{on "click" (fn this.openRemoveModal codelist)}}
            >
              {{t "utility.delete"}}
            </AuButton>
          </td>
        </c.body>
      </s.content>
    </AuDataTable>
  </m.content>
</AuMainContainer>

<AuModal
  @title={{t "utility.confirmation.body"}}
  @modalOpen={{this.isRemoveModalOpen}}
  @closeModal={{this.closeRemoveModal}}
  as |Modal|
>
  <Modal.Body>
    <p>
      {{t
        "codelist.crud.confirm-deletion"
        name=this.modalCodelist.label
        htmlSafe=true
      }}
    </p>
  </Modal.Body>
  <Modal.Footer>
    <AuButton
      @alert={{true}}
      @loading={{this.removeCodelist.isRunning}}
      @loadingMessage={{t "utility.deleting"}}
      {{on "click" (perform this.removeCodelist)}}
    >
      {{t "codelist.crud.delete"}}
    </AuButton>
    <AuButton @skin="secondary" {{on "click" this.closeRemoveModal}}>
      {{t "utility.cancel"}}
    </AuButton>
  </Modal.Footer>
</AuModal>