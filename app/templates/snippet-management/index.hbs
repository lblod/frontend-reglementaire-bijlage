<AuMainContainer as |m|>
  <m.sidebar class="snippet-management__sidebar">
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content">
        <SnippetManagement::Filters
          @onChangeLabel={{this.changeFilterLabel.perform}}
          @label={{this.label}}
          @onChangeTags={{this.changeFilterTags}}
          @onResetFilters={{this.resetFilters}}
          @selectedTags={{this.model.selectedTags}}
        />
      </div>
    </div>
  </m.sidebar>
  <m.content @scroll={{true}}>
    <AuDataTable
      @content={{this.model.snippetLists}}
      @fields="label importedResources"
      @noDataMessage={{t "snippets.manage-snippet-lists.table.no-data"}}
      @size={{this.size}}
      @page={{this.page}}
      @sort={{this.sort}}
      as |s|
    >
      <s.menu as |menu|>
        <menu.general>
          <AuToolbar class="au-o-box" as |Group|>
            <Group>
              <AuHeading @skin="2">
                {{t "snippets.manage-snippet-lists.title"}}
              </AuHeading>
            </Group>
            <Group class="au-c-toolbar__group--center">
              <TemplateExporter
                @snippetListUris={{this.selectedSnippetLists}}
              />
              <TemplateImporter @onSuccess={{this.refresh}} />
              <AuLink
                @icon="add"
                @skin="button"
                @route="snippet-management.new"
              >
                {{t "snippets.manage-snippet-lists.make-new"}}
              </AuLink>
              {{#if this.isReadMode}}
                <AuButton
                  {{on "click" (set this "isReadMode" false)}}
                  @skin="secondary"
                  @icon="pencil"
                >{{t "template-management.edit-mode"}}</AuButton>
              {{else}}
                <AuButton
                  {{on "click" (set this "isReadMode" true)}}
                  @skin="secondary"
                  @icon="pencil"
                >{{t "template-management.read-mode"}}</AuButton>
              {{/if}}
            </Group>
          </AuToolbar>
        </menu.general>
      </s.menu>
      <s.content as |c|>
        <c.header>
          <th>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                @checked={{this.selectAllChecked}}
                {{on "click" this.onSelectAllChange}}
              />
            {{/let}}
          </th>
          <AuDataTableThSortable
            @field=":no-case:label"
            @currentSorting={{this.sort}}
            @label={{t "snippets.manage-snippet-lists.table.columns.label"}}
          />
          <th>{{t "snippets.manage-snippet-lists.table.columns.id"}}</th>
          <th>{{t "snippets.manage-snippet-lists.table.columns.imported"}}</th>
          <th>{{t "snippets.manage-snippet-lists.table.columns.tags"}}</th>
          <th></th>
        </c.header>
        <c.body as |snippetList|>
          <td>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                value={{snippetList.uri}}
                @checked={{this.isSelected snippetList.uri}}
                {{on "click" this.onSnippetListSelectionChange}}
              />
            {{/let}}
          </td>
          <td>
            <AuLink
              @skin="primary"
              @route="snippet-management.edit"
              @model={{snippetList.id}}
            >
              {{snippetList.label}}
            </AuLink>
          </td>
          <td>
            {{snippetList.id}}
          </td>
          <td>
            {{snippetList.importedResources}}
          </td>
          <td>
            {{#if this.isReadMode}}
              <CollapsibleTagList @tags={{snippetList.tags}} />
            {{else}}
              <TagSelector
                @onChange={{fn this.changeTagsFor snippetList}}
                @selectedTags={{snippetList.tags}}
                @allowCreate={{true}}
                @tagList={{this.tagList}}
              />
            {{/if}}
          </td>
          <td class="au-u-padding-right-none">
            <AuButton
              @skin="naked"
              @icon="trash"
              @alert={{true}}
              @hideText={{true}}
              {{on "click" (fn this.openRemoveModal snippetList)}}
            >
              {{t "utility.delete"}}
            </AuButton>
          </td>
        </c.body>
      </s.content>
    </AuDataTable>
  </m.content>
</AuMainContainer>
<AuModal
  @title={{t "utility.confirmation.body"}}
  @modalOpen={{this.isRemoveModalOpen}}
  @closeModal={{this.closeRemoveModal}}
  as |Modal|
>
  <Modal.Body>
    <p>
      {{t
        "snippets.manage-snippet-lists.snippet-list-deletion.confirm"
        name=this.deletingSnippetList.label
        htmlSafe=true
      }}
    </p>
  </Modal.Body>
  <Modal.Footer>
    <AuButton
      @alert={{true}}
      @loading={{this.removeSnippetList.isRunning}}
      @loadingMessage={{t "utility.deleting"}}
      {{on "click" (perform this.removeSnippetList)}}
    >
      {{t "snippets.manage-snippet-lists.snippet-list-deletion.action.long"}}
    </AuButton>
    <AuButton @skin="secondary" {{on "click" this.closeRemoveModal}}>
      {{t "utility.cancel"}}
    </AuButton>
  </Modal.Footer>
</AuModal>