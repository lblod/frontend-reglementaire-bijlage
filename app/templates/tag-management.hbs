{{page-title (t 'snippets.manage-snippet-lists.title')}}
<BreadcrumbsItem as |linkClass|>
  <AuLink @route='snippet-management' class={{linkClass}}>
    {{t 'tag-management.title'}}
  </AuLink>
</BreadcrumbsItem>
<AuDataTable
  @content={{this.model.templateTags}}
  @fields="Label"
  @noDataMessage={{t "tag-management.crud.no-data"}}
  @size={{this.size}}
  @page={{this.page}}
  @sort={{this.sort}}
  as |s|
>
  <s.menu as |menu|>
    <menu.general>
      <AuToolbar class="au-o-box" as |Group|>
        <Group>
          <AuHeading @skin="2">
            {{t "tag-management.manage-tags.title"}}
          </AuHeading>
        </Group>
        <Group class="au-c-toolbar__group--center">
          {{! Copied from the AuDataTable::TextSearch component since that doesn't support calling actions on input}}
          <div class="au-c-data-table__search">
            <SearchForm
              @value={{this.searchQuery}}
              @placeholder={{t "codelist.crud.label-filter"}}
              @onInput={{this.updateSearchQuery}}
              @onSearch={{this.search}}
            />
          </div>
          <AuLink @route="tag-management.new" @icon="add" @skin="button">
            {{t "tag-management.crud.new"}}
          </AuLink>
        </Group>
      </AuToolbar>
    </menu.general>
  </s.menu>
  <s.content as |c|>
    <c.header>
      <AuDataTableThSortable
        @field=":no-case:label"
        @currentSorting={{this.sort}}
        @label={{t "utility.attr.name"}}
      />
      <th>{{t "utility.attr.id"}}</th>
      <AuDataTableThSortable
        @field="createdOn"
        @currentSorting={{this.sort}}
        @label={{t "utility.attr.created-on"}}
      />
      <th></th>
    </c.header>
    <c.body as |tag|>
      <td>
        <AuLink
          @skin="primary"
          @route="tag-management.edit"
          @model={{tag.id}}
        >
          {{tag.label}}
        </AuLink>
      </td>
      <td>
        {{tag.id}}
      </td>
      <td>
        {{#if tag.createdOn}}
          {{detailed-date tag.createdOn}}
        {{else}}
          {{t "codelist.attr.not-found"}}
        {{/if}}
      </td>
      <td>
        <AuButton
          @skin="naked"
          @icon="trash"
          @alert={{true}}
          {{on "click" (fn this.openRemoveModal tag)}}
        >
          {{t "utility.delete"}}
        </AuButton>
      </td>
    </c.body>
  </s.content>
</AuDataTable>

<AuModal
  @title={{t "utility.confirmation.body"}}
  @modalOpen={{this.isRemoveModalOpen}}
  @closeModal={{this.closeRemoveModal}}
  as |Modal|
>
  <Modal.Body>
    <p>
      {{t
        "codelist.crud.confirm-deletion"
        name=this.modalCodelist.label
        htmlSafe=true
      }}
    </p>
  </Modal.Body>
  <Modal.Footer>
    <AuButton
      @alert={{true}}
      @loading={{this.removeCodelist.isRunning}}
      @loadingMessage={{t "utility.deleting"}}
      {{on "click" (perform this.removeCodelist)}}
    >
      {{t "codelist.crud.delete"}}
    </AuButton>
    <AuButton @skin="secondary" {{on "click" this.closeRemoveModal}}>
      {{t "utility.cancel"}}
    </AuButton>
  </Modal.Footer>
</AuModal>
{{outlet}}