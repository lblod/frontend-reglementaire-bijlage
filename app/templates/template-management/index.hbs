{{page-title (t "template-management.page-title")}}
<AuMainContainer as |m|>
  <m.sidebar class="template-management__sidebar">
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content">
        <TemplateManagement::Filters
          @onChangeTemplateTitle={{this.changeFilterTitle.perform}}
          @templateTitle={{this.title}}
          @onChangeTemplateTypes={{this.changeFilterTemplateTypes}}
          @onChangeTemplateTags={{this.changeFilterTemplateTags}}
          @onResetFilters={{this.resetFilters}}
          @selectedTemplateTypes={{this.templateTypes}}
          @selectedTags={{this.model.selectedTags}}
        />
      </div>
    </div>
  </m.sidebar>
  <m.content @scroll={{true}}>
    <AuDataTable
      @content={{this.model.documentContainer}}
      @isLoading={{this.isLoadingModel}}
      @noDataMessage={{t "template-management.no-data-message"}}
      @sort={{this.sort}}
      @page={{this.page}}
      @size={{this.size}}
      as |table|
    >
      <table.menu as |menu|>
        <menu.general>
          <AuToolbar class="au-o-box" @size="large" as |Group|>
            <Group>
              <AuHeading @skin="2">
                {{t "template-management.page-title"}}
              </AuHeading>
            </Group>
            <Group>
              {{#unless this.isReadOnly}}
                {{#if (gt this.selectedTemplates.size 0)}}
                  <AuButton
                    {{on "click" this.showBulkEditModal}}
                    @skin="secondary"
                    @icon="pencil"
                    @disabled={{this.saveBulkEdit.isRunning}}
                  >{{t "template-management.bulk-edit"}}</AuButton>
                {{/if}}
              {{/unless}}
              <TemplateExporter @templateUris={{this.selectedTemplates}} />
              <TemplateImporter @onSuccess={{this.refresh}} />
              {{#unless this.readOnly}}
                <AuButton
                  @icon="add"
                  @iconAlignment="left"
                  {{on "click" this.startCreateTemplateFlow}}
                >{{t "template-management.new"}}</AuButton>
                {{#if this.isReadMode}}
                  <AuButton
                    {{on "click" this.enableEditMode}}
                    @skin="secondary"
                    @icon="pencil"
                  >{{t "template-management.edit-mode"}}</AuButton>
                {{else}}
                  <AuButton
                    {{on "click" this.enableReadMode}}
                    @skin="secondary"
                    @icon="pencil"
                  >{{t "template-management.read-mode"}}</AuButton>
                {{/if}}
              {{/unless}}
            </Group>
          </AuToolbar>
        </menu.general>
      </table.menu>
      <table.content as |c|>
        <c.header>
          <th>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                @checked={{this.selectAllChecked}}
                {{on "click" this.onSelectAllChange}}
              />
            {{/let}}
          </th>
          <AuDataTableThSortable
            @field=":no-case:currentVersion.title"
            @currentSorting={{this.sort}}
            @label={{t "template-management.title"}}
          />
          <th>{{t "template-management.template-status"}}</th>
          <th>{{t "template-management.template-type.label"}}</th>
          <AuDataTableThSortable
            @field="currentVersion.createdOn"
            @currentSorting={{this.sort}}
            @label={{t "template-management.created-on"}}
          />
          <AuDataTableThSortable
            @field="currentVersion.updatedOn"
            @currentSorting={{this.sort}}
            @label={{t "template-management.updated-on"}}
          />
          <th>{{t "template-management.tags.label"}}</th>
          <th></th>
        </c.header>
        <c.body as |documentContainer|>
          <td>
            {{#let (unique-id) as |id|}}
              <AuCheckbox
                id={{id}}
                value={{documentContainer.uri}}
                @checked={{this.isSelected documentContainer.uri}}
                {{on "click" this.onTemplateSelectionChange}}
              />
            {{/let}}
          </td>
          <td class="au-u-word-nowrap template-management-table--title">
            <LinkTo
              @route="template-management.edit"
              @model={{documentContainer.id}}
              class="au-c-link"
              title={{documentContainer.currentVersion.title}}
            >
              {{documentContainer.currentVersion.title}}
            </LinkTo>
          </td>
          <td>
            <this.PublicationStatus
              @validity={{await (this.publishedTemplate documentContainer)}}
            />
          </td>
          <td class="au-u-word-nowrap">
            {{await (this.getTemplateTypeLabel documentContainer)}}
          </td>
          <td class="au-u-word-nowrap">{{detailed-date
              documentContainer.currentVersion.createdOn
            }}</td>
          <td class="au-u-word-nowrap">{{detailed-date
              documentContainer.currentVersion.updatedOn
            }}</td>
          <td>
            {{#let (await documentContainer.tags) as |tags|}}
              {{#if this.isReadMode}}
                {{#if tags}}
                  <Common::Tags::CollapsibleTagList @tags={{sort-tags tags}} />
                {{/if}}
              {{else}}
                <Common::Tags::TagSelector
                  @tags={{this.tagManager.tags}}
                  @selectedTags={{tags}}
                  @onChange={{fn this.changeTagsFor documentContainer}}
                  @allowTagCreation={{true}}
                  @tagConstructor={{this.tagManager.createTag}}
                />
              {{/if}}
            {{/let}}
          </td>
          <td class="au-u-padding-none">
            <AuButton
              @skin="naked"
              @icon="trash"
              @alert={{true}}
              @hideText={{true}}
              @size="large"
              {{on "click" (fn this.startRemoveTemplateFlow documentContainer)}}
            />
          </td>
        </c.body>
      </table.content>
    </AuDataTable>
  </m.content>
</AuMainContainer>
<AuModal
  @title={{t "template-management.create-modal.title"}}
  @modalOpen={{this.createTemplateModalIsOpen}}
  @closeModal={{this.cancelCreateTemplate}}
  as |Modal|
>
  <Modal.Body>
    <form
      class="au-c-form"
      id="create-meeting-form"
      {{on "submit" (perform this.saveTemplate)}}
    >
      <AuFormRow>
        <AuLabel @required={{true}} for="template-title">
          {{t "template-management.title"}}
        </AuLabel>
        <AuInput
          value={{this.editorDocument.title}}
          @width="block"
          id="template-title"
          type="text"
          {{on "input" this.handleTitleUpdate}}
        />
      </AuFormRow>
      <AuFormRow>
        <AuLabel for="template-type">
          {{t "template-management.template-type.label"}}
        </AuLabel>
        <PowerSelect
          id="template-type"
          @allowClear={{false}}
          @searchEnabled={{false}}
          @options={{this.allTemplateTypes}}
          @selected={{this.templateTypeToCreate}}
          @onChange={{this.updateTemplateType}}
          as |templateType|
        >
          {{templateType.label}}
        </PowerSelect>
      </AuFormRow>
      <AuFormRow>
        <AuLabel for="template-type">
          {{t "template-management.tags.label"}}
        </AuLabel>
        <Common::Tags::TagSelector
          @tags={{this.tagManager.tags}}
          @selectedTags={{this.tagsToCreate}}
          @onChange={{this.updateTemplateTags}}
          @allowTagCreation={{true}}
          @tagConstructor={{this.tagManager.createTag}}
        />
      </AuFormRow>
    </form>
  </Modal.Body>
  <Modal.Footer>
    <AuButtonGroup>
      <AuButton
        class="au-c-button"
        form="create-meeting-form"
        type="submit"
        @disabled={{this.isInvalidTemplateTitle}}
      >
        {{t "template-management.create-modal.save"}}
      </AuButton>
      <AuButton {{on "click" this.cancelCreateTemplate}} @skin="secondary">
        {{t "template-management.create-modal.cancel"}}
      </AuButton>
    </AuButtonGroup>
  </Modal.Footer>
</AuModal>
<ConfirmModal
  @confirmMessage={{t "template-management.remove-modal.remove"}}
  @modalOpen={{this.removeTemplateModalIsOpen}}
  @closeModal={{this.closeRemoveTemplateModal}}
  @onConfirm={{perform this.submitRemoveTemplate}}
  @onCancel={{this.cancelRemoveTemplate}}
  @isAlert={{true}}
>
  <:title>
    {{t "template-management.remove-modal.title"}}
  </:title>
</ConfirmModal>
{{#if this.bulkEditModalIsOpen}}
  <BulkEditTagsModal
    @onClose={{this.closeBulkEditModal}}
    @onSave={{this.saveBulkEdit.perform}}
  />
{{/if}}